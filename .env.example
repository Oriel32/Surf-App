# Copy this file to `.env` and put the real values THERE, not here.
# `.env` is gitignored; this file is committed, so it must never hold a secret.
#
# Israel Meteorological Service - measured coastal wind.
# Request a token by email from ims@ims.gov.il (see docs/INSTALL.md).
# Sent as the header `Authorization: ApiToken <token>`.
# Quotes are optional: IMS_API_TOKEN=abc and IMS_API_TOKEN="abc" both work.
IMS_API_TOKEN=

# Stormglass - model confidence. Free tier is ~10 requests/day, so this is
# deliberately not wired into the app or the smoke test yet.
STORMGLASS_API_KEY=
